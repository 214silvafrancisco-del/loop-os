# Copiar para .env.local e preencher. NUNCA fazer commit de .env.local.

# Step 02 — Supabase / Postgres
# Usar sempre o POOLER (IPv4). A ligação direta db.<ref>.supabase.co é só IPv6 e
# não resolve em redes domésticas. Host do pooler deste projeto: aws-1-eu-west-1.
# App (modo transação, porta 6543):
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
# Migrações e seed (modo sessão, porta 5432):
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
# Se o host não for conhecido: node --env-file=.env.local scripts/db-find-pooler.mjs

# URL pública da app (links de email, propostas). Em dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Step 03 — Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Step 11 — Cloudflare R2 (documentos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=loop-documents
