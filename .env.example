# Copiar para .env.local e preencher. NUNCA fazer commit de .env.local.

# Step 02 — Supabase / Postgres
# App (pooler em modo transação, porta 6543):
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Migrações e seed (ligação direta ou pooler em modo sessão, porta 5432):
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Step 03 — Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Step 11 — Cloudflare R2 (documentos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=loop-documents
